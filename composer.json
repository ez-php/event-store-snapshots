{
  "name": "ez-php/event-store-snapshots",
  "version": "2.6.5",
  "description": "Snapshot store for ez-php/event-store streams: PDO and in-memory stores, every-N-events policy, snapshot-aware loader",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["event-sourcing", "snapshots", "event-store", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/event-store-snapshots",
  "support": {
    "issues": "https://github.com/ez-php/event-store-snapshots/issues",
    "source": "https://github.com/ez-php/event-store-snapshots"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^2.6.0",
    "ez-php/event-store": "^2.6.0"
  },
  "require-dev": {
    "ez-php/docker": "^2.6.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\EventStoreSnapshots\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
